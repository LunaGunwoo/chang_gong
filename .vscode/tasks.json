{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Compile sketch",
      "type": "process",
      "command": "${workspaceFolder}/.tools/arduino-cli.exe",
      "args": [
        "compile",
        "--fqbn", "esp32:esp32:esp32",
        "--build-path", "${workspaceFolder}/build/${input:sketch}",
        "${workspaceFolder}/${input:sketch}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ],
  "inputs": [
    {
      "id": "sketch",
      "type": "pickString",
      "description": "컴파일할 Arduino 스케치",
      "options": ["servo_ping", "wifi_setup"],
      "default": "servo_ping"
    }
  ]
}
